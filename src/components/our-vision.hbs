{{!-- Our Vision Page Component --}}
<div class="container py-5" id="{{pageId}}">
  <!-- Hero Section -->
  <div class="row mb-5">
    <div class="col-12 text-center">
      <h1 class="display-3 fw-bold text-primary mb-4">{{title}}</h1>
      <p class="lead fs-4 text-muted mb-5">{{subtitle}}</p>
    </div>
  </div>

  <!-- Vision Statement -->
  <div class="row justify-content-center mb-5">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg">
        <div class="card-body p-5 text-center">
          <i class="fas fa-eye text-primary mb-4" style="font-size: 3rem;"></i>
          <h2 class="h3 fw-bold mb-4">Our Vision</h2>
          <p class="lead">{{visionStatement}}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Mission & Values -->
  <div class="row mb-5">
    <!-- Mission -->
    <div class="col-lg-6 mb-4">
      <div class="card h-100 border-0 shadow">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <i class="fas fa-bullseye text-primary" style="font-size: 2.5rem;"></i>
            <h3 class="mt-3">Our Mission</h3>
          </div>
          <p>{{missionStatement}}</p>
          <ul class="list-unstyled">
            {{#each missionPoints}}
            <li class="mb-2">
              <i class="fas fa-arrow-right text-primary me-2"></i>{{this}}
            </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>

    <!-- Core Values -->
    <div class="col-lg-6 mb-4">
      <div class="card h-100 border-0 shadow">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <i class="fas fa-heart text-primary" style="font-size: 2.5rem;"></i>
            <h3 class="mt-3">Core Values</h3>
          </div>
          {{#each coreValues}}
          <div class="mb-3">
            <h5 class="text-primary mb-1">{{name}}</h5>
            <p class="mb-0 small">{{description}}</p>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  <!-- Future Goals -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="text-center mb-4">
        <h2 class="fw-bold">Our Future Goals</h2>
        <p class="text-muted">Where we're heading in the next few years</p>
      </div>
      
      <div class="row">
        {{#each futureGoals}}
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-4">
              <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" 
                   style="width: 80px; height: 80px;">
                <i class="{{icon}} text-primary lighten fa-2x"></i>
              </div>
              <h5 class="fw-bold mb-3">{{title}}</h5>
              <p class="text-muted mb-3">{{description}}</p>
              <small class="text-primary fw-semibold">Target: {{timeline}}</small>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>

  <!-- Impact Statistics -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="bg-primary bg-gradient text-white rounded-3 p-5">
        <div class="text-center mb-4">
          <h2 class="fw-bold text-white">Our Impact So Far</h2>
        </div>
        <div class="row text-center">
          {{#each impactStats}}
          <div class="col-lg-3 col-md-6 mb-3">
            <div class="border-end border-light border-opacity-25 h-100 d-flex flex-column justify-content-center">
              <h3 class="display-5 fw-bold text-white mb-0">{{value}}</h3>
              <p class="text-white-50 mb-0">{{label}}</p>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  <!-- Team Leadership -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="text-center mb-4">
        <h2 class="fw-bold">Leadership Team</h2>
        <p class="text-muted">The visionaries behind our success</p>
      </div>
      
      <div class="row justify-content-center">
        {{#each leadership}}
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="card border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <img src="{{photo}}" class="rounded-circle mb-3" width="80" height="80" alt="{{name}}">
              <h5 class="fw-bold mb-1">{{name}}</h5>
              <p class="text-primary mb-2">{{position}}</p>
              <p class="text-muted small">{{bio}}</p>
              <div class="d-flex justify-content-center gap-2">
                {{#each socialLinks}}
                <a href="{{url}}" class="text-muted" target="_blank">
                  <i class="{{icon}}"></i>
                </a>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>

  <!-- Call to Action -->
  <div class="row">
    <div class="col-12 text-center">
      <div class="bg-light rounded-3 p-5">
        <h3 class="fw-bold mb-3">Join Our Journey</h3>
        <p class="text-muted mb-4">Be part of our vision to transform the future through innovation and technology.</p>
        <div class="d-flex justify-content-center gap-3">
          <button class="btn btn-primary btn-lg">
            <i class="fas fa-users me-2"></i>Join Our Team
          </button>
          <button class="btn btn-outline-primary btn-lg">
            <i class="fas fa-handshake me-2"></i>Partner With Us
          </button>
        </div>
      </div>
    </div>
  </div>
</div>