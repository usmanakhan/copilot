{{!-- Product Details Page Component --}}
<div class="container py-5" id="{{pageId}}">
  <div class="row">
    <!-- Product Images -->
    <div class="col-lg-6">
      <div class="product-gallery">
        <div class="main-image mb-3">
          <img src="{{mainImage}}" class="img-fluid rounded shadow" alt="{{productName}}">
        </div>
        <div class="thumbnail-images">
          <div class="row g-2">
            {{#each thumbnails}}
            <div class="col-3">
              <img src="{{this}}" class="img-fluid rounded thumbnail-img" alt="{{../productName}}" style="cursor: pointer;">
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>

    <!-- Product Information -->
    <div class="col-lg-6">
      <div class="product-info">
        <h1 class="mb-3">{{productName}}</h1>
        <div class="rating mb-3">
          <div class="d-flex align-items-center">
            {{#repeat rating}}
            <i class="fas fa-star text-warning"></i>
            {{/repeat}}
            {{#repeat (subtract 5 rating)}}
            <i class="far fa-star text-muted"></i>
            {{/repeat}}
            <span class="ms-2 text-muted">({{reviewCount}} reviews)</span>
          </div>
        </div>
        
        <div class="price mb-4">
          {{#if discountPrice}}
          <span class="h2 text-primary fw-bold">${{discountPrice}}</span>
          <span class="text-muted text-decoration-line-through ms-2">${{originalPrice}}</span>
          <span class="badge bg-danger ms-2">Save ${{subtract originalPrice discountPrice}}</span>
          {{else}}
          <span class="h2 text-primary fw-bold">${{originalPrice}}</span>
          {{/if}}
        </div>

        <div class="product-description mb-4">
          <p>{{description}}</p>
        </div>

        <!-- Product Features -->
        <div class="features mb-4">
          <h5>Key Features:</h5>
          <ul class="list-unstyled">
            {{#each features}}
            <li class="mb-2">
              <i class="fas fa-check text-success me-2"></i>{{this}}
            </li>
            {{/each}}
          </ul>
        </div>

        <!-- Specifications -->
        <div class="specifications mb-4">
          <h5>Specifications:</h5>
          <div class="table-responsive">
            <table class="table table-sm">
              {{#each specifications}}
              <tr>
                <td class="fw-semibold">{{name}}:</td>
                <td>{{value}}</td>
              </tr>
              {{/each}}
            </table>
          </div>
        </div>

        <!-- Purchase Options -->
        <div class="purchase-options">
          <div class="d-grid gap-2 d-md-flex">
            <button class="btn btn-primary btn-lg flex-md-fill me-md-2">
              <i class="fas fa-shopping-cart me-2"></i>Add to Cart
            </button>
            <button class="btn btn-outline-primary btn-lg flex-md-fill">
              <i class="fas fa-heart me-2"></i>Wishlist
            </button>
          </div>
          <div class="mt-3 text-center">
            <small class="text-muted">
              <i class="fas fa-truck me-1"></i>Free shipping on orders over $100
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Additional Product Tabs -->
  <div class="row mt-5">
    <div class="col-12">
      <ul class="nav nav-tabs" id="productTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
            Reviews ({{reviewCount}})
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="warranty-tab" data-bs-toggle="tab" data-bs-target="#warranty" type="button" role="tab">
            Warranty & Support
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="shipping-tab" data-bs-toggle="tab" data-bs-target="#shipping" type="button" role="tab">
            Shipping Info
          </button>
        </li>
      </ul>

      <div class="tab-content p-4 border border-top-0 rounded-bottom bg-white">
        <div class="tab-pane fade show active" id="reviews" role="tabpanel">
          <h5>Customer Reviews</h5>
          {{#each reviews}}
          <div class="review-item border-bottom pb-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <strong>{{name}}</strong>
              <div>
                {{#repeat rating}}
                <i class="fas fa-star text-warning"></i>
                {{/repeat}}
                {{#repeat (subtract 5 rating)}}
                <i class="far fa-star text-muted"></i>
                {{/repeat}}
              </div>
            </div>
            <p class="mb-1">{{comment}}</p>
            <small class="text-muted">{{date}}</small>
          </div>
          {{/each}}
        </div>
        
        <div class="tab-pane fade" id="warranty" role="tabpanel">
          <h5>Warranty Information</h5>
          <p>This product comes with a {{warrantyPeriod}} warranty covering manufacturing defects and normal wear and tear.</p>
          <ul>
            <li>24/7 Customer Support</li>
            <li>Free replacement for defective units</li>
            <li>Extended warranty options available</li>
          </ul>
        </div>
        
        <div class="tab-pane fade" id="shipping" role="tabpanel">
          <h5>Shipping & Delivery</h5>
          <p><strong>Standard Delivery:</strong> 3-5 business days - $5.99</p>
          <p><strong>Express Delivery:</strong> 1-2 business days - $12.99</p>
          <p><strong>Free Shipping:</strong> On orders over $100</p>
        </div>
      </div>
    </div>
  </div>
</div>