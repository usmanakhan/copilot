{{!-- filepath: src/templates/tabs-section.hbs --}}
<div class="container py-5" id="{{sectionId}}">
  <h2 class="mb-4 pt-4">{{title}}</h2>
  <ul class="nav nav-tabs" id="{{tabsId}}" role="tablist">
    {{#each tabs}}
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#if active}}active{{/if}}" 
              id="{{id}}-tab" 
              data-bs-toggle="tab" 
              data-bs-target="#{{id}}" 
              type="button" 
              role="tab" 
              aria-controls="{{id}}" 
              aria-selected="{{active}}">
        {{title}}
      </button>
    </li>
    {{/each}}
  </ul>
  <div class="tab-content p-4 border border-top-0 rounded-bottom bg-white" id="{{tabsId}}Content">
    {{#each tabs}}
    <div class="tab-pane fade {{#if active}}show active{{/if}}" 
         id="{{id}}" 
         role="tabpanel" 
         aria-labelledby="{{id}}-tab">
      <h4>{{title}}</h4>
      {{{content}}}
    </div>
    {{/each}}
  </div>
</div>